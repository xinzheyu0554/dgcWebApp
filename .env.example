# Neon Console > dgc > Connect > production > pooled connection string.
# SERVER-SIDE ONLY! Do not prefix secrets with REACT_APP_.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# GitHub > Settings > Developer settings > Personal access tokens > Fine-grained tokens.
# Access: ONLY this repository, Repository permissions: Contents = Read and write.
# Token must only be configured locally and in Netlify Functions environment.
GITHUB_TOKEN=github_pat_REPLACE_ME
GITHUB_OWNER=YOUR_GITHUB_USERNAME_OR_ORG
GITHUB_REPO=doncaster-garden-club
GITHUB_BRANCH=main

# Keep any original site env variables (Cloudinary, etc.) from your existing .env.
